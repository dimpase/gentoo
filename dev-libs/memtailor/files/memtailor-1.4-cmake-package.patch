diff --git a/cmake/memtailor.pc.in b/cmake/memtailor.pc.in
new file mode 100644
index 0000000..7a6f01e
--- /dev/null
+++ b/cmake/memtailor.pc.in
@@ -0,0 +1,11 @@
+prefix=@CMAKE_INSTALL_PREFIX@
+libdir=@CMAKE_INSTALL_FULL_LIBDIR@
+includedir=@CMAKE_INSTALL_FULL_INCLUDEDIR@
+
+Name: memtailor
+Description: C++ library of special purpose memory allocators
+URL: https://github.com/Macaulay2/memtailor
+Version: @PROJECT_VERSION@
+Libs: -L${libdir} -lmemtailor
+Libs.private: @CMAKE_THREAD_LIBS_INIT@
+Cflags: -I${includedir} $<$<CONFIG:Debug>:-DMEMT_DEBUG>
diff --git a/cmake/memtailorConfig.cmake.in b/cmake/memtailorConfig.cmake.in
new file mode 100644
index 0000000..123f62e
--- /dev/null
+++ b/cmake/memtailorConfig.cmake.in
@@ -0,0 +1,11 @@
+@PACKAGE_INIT@
+
+include(CMakeFindDependencyMacro)
+find_dependency(Threads)
+include("${CMAKE_CURRENT_LIST_DIR}/memtailorTargets.cmake")
+# Record the installed library's ABI, not the consumer's build configuration.
+if($<CONFIG:Debug>)
+  set_property(TARGET memtailor::memtailor APPEND PROPERTY
+    INTERFACE_COMPILE_DEFINITIONS MEMT_DEBUG)
+endif()
+check_required_components(memtailor)
diff --git a/cmake/tests/CMakeLists.txt b/cmake/tests/CMakeLists.txt
new file mode 100644
index 0000000..b0ea5a9
--- /dev/null
+++ b/cmake/tests/CMakeLists.txt
@@ -0,0 +1,10 @@
+cmake_minimum_required(VERSION 3.12)
+project(memtailor-consumer LANGUAGES CXX)
+find_package(memtailor 1.4 CONFIG REQUIRED)
+add_executable(consumer consumer.cpp)
+target_link_libraries(consumer PRIVATE memtailor::memtailor)
+if(EXPECT_MEMT_DEBUG)
+  target_compile_definitions(consumer PRIVATE EXPECT_MEMT_DEBUG)
+endif()
+enable_testing()
+add_test(NAME installed-consumer COMMAND consumer)
diff --git a/cmake/tests/consumer.cpp b/cmake/tests/consumer.cpp
new file mode 100644
index 0000000..105ac49
--- /dev/null
+++ b/cmake/tests/consumer.cpp
@@ -0,0 +1,12 @@
+#include <memtailor.h>
+
+#if defined(EXPECT_MEMT_DEBUG) != defined(MEMT_DEBUG)
+#error MEMT_DEBUG must agree with the installed library
+#endif
+static_assert(__cplusplus >= 201703L, "memtailor requires C++17");
+
+int main() {
+  memt::Arena arena;
+  void* p = arena.alloc(32);
+  arena.freeTop(p);
+}
