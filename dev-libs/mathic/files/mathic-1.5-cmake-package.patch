diff --git a/cmake/FindMemtailor.cmake b/cmake/FindMemtailor.cmake
index da04bdc..3672613 100644
--- a/cmake/FindMemtailor.cmake
+++ b/cmake/FindMemtailor.cmake
@@ -1,24 +1,24 @@
-# Try to find the MEMTAILOR libraries
-# See https://github.com/Macaulay2/memtailor
-#
-# This file sets up GLPK for CMake. Once done this will define
-#  MEMTAILOR_FOUND             - system has MEMTAILOR lib
-#  MEMTAILOR_INCLUDE_DIR       - the MEMTAILOR include directory
-#  MEMTAILOR_LIBRARIES         - Libraries needed to use MEMTAILOR
-#
+# Prefer the upstream config; pkg-config also carries the dependency's ABI flags.
 # Copyright (c) 2020, Mahrud Sayrafi, <mahrud@umn.edu>
-#
 # Redistribution and use is allowed according to the terms of the BSD license.
-
-find_path(MEMTAILOR_INCLUDE_DIR NAMES memtailor.h
-  PATHS ${INCLUDE_INSTALL_DIR} ${CMAKE_INSTALL_PREFIX}/include
-  PATH_SUFFIXES memtailor
-  )
-find_library(MEMTAILOR_LIBRARIES NAMES memtailor
-  PATHS ${LIB_INSTALL_DIR} ${CMAKE_INSTALL_PREFIX}/lib
-  )
-
+if(NOT TARGET memtailor::memtailor)
+  find_package(memtailor CONFIG QUIET)
+endif()
+if(NOT TARGET memtailor::memtailor)
+  find_package(PkgConfig QUIET)
+  if(PKG_CONFIG_FOUND)
+    pkg_check_modules(MEMTAILOR QUIET IMPORTED_TARGET memtailor)
+    if(TARGET PkgConfig::MEMTAILOR)
+      add_library(memtailor::memtailor INTERFACE IMPORTED)
+      set_property(TARGET memtailor::memtailor PROPERTY
+        INTERFACE_LINK_LIBRARIES PkgConfig::MEMTAILOR)
+    endif()
+  endif()
+endif()
+set(MEMTAILOR_FOUND FALSE)
+if(TARGET memtailor::memtailor)
+  set(MEMTAILOR_FOUND TRUE)
+  set(MEMTAILOR_LIBRARIES memtailor::memtailor)
+endif()
 include(FindPackageHandleStandardArgs)
-FIND_PACKAGE_HANDLE_STANDARD_ARGS(Memtailor DEFAULT_MSG MEMTAILOR_INCLUDE_DIR MEMTAILOR_LIBRARIES)
-
-mark_as_advanced(MEMTAILOR_INCLUDE_DIR MEMTAILOR_LIBRARIES)
+find_package_handle_standard_args(Memtailor DEFAULT_MSG MEMTAILOR_FOUND)
diff --git a/cmake/mathic.pc.in b/cmake/mathic.pc.in
new file mode 100644
index 0000000..a0692d8
--- /dev/null
+++ b/cmake/mathic.pc.in
@@ -0,0 +1,12 @@
+prefix=@CMAKE_INSTALL_PREFIX@
+libdir=@CMAKE_INSTALL_FULL_LIBDIR@
+includedir=@CMAKE_INSTALL_FULL_INCLUDEDIR@
+
+Name: mathic
+Description: mathic library for Groebner basis computations
+URL: https://github.com/Macaulay2/mathic
+Version: @PROJECT_VERSION@
+Requires: memtailor
+Libs: -L${libdir} -lmathic
+Libs.private: @CMAKE_THREAD_LIBS_INIT@
+Cflags: -I${includedir} $<$<CONFIG:Debug>:-DMATHIC_DEBUG>
diff --git a/cmake/mathicConfig.cmake.in b/cmake/mathicConfig.cmake.in
new file mode 100644
index 0000000..dee18be
--- /dev/null
+++ b/cmake/mathicConfig.cmake.in
@@ -0,0 +1,14 @@
+@PACKAGE_INIT@
+include(CMakeFindDependencyMacro)
+find_dependency(Threads)
+set(_mathic_module_path "${CMAKE_MODULE_PATH}")
+list(INSERT CMAKE_MODULE_PATH 0 "${CMAKE_CURRENT_LIST_DIR}")
+find_dependency(Memtailor)
+set(CMAKE_MODULE_PATH "${_mathic_module_path}")
+include("${CMAKE_CURRENT_LIST_DIR}/mathicTargets.cmake")
+# The ABI is determined by the installed library, not the consumer build type.
+if($<CONFIG:Debug>)
+  set_property(TARGET mathic::mathic APPEND PROPERTY
+    INTERFACE_COMPILE_DEFINITIONS MATHIC_DEBUG)
+endif()
+check_required_components(mathic)
